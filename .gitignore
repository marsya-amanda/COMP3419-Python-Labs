# COMP3419 private-repository hygiene
#
# A private GitHub repository is not a secrets store. Keep credentials,
# student records, submissions, and machine-local state outside Git even when
# repository access is restricted.
#
# Intentionally tracked course sources include .python-version, pyproject.toml,
# uv.lock, canonical notebooks and their reviewed outputs, tests, raw teaching
# media, legacy staff references, and Panda3D source assets.

# Python bytecode and native build products
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.dylib

# Shared uv environment and other local Python environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/
.uv/
.uv-cache/

# Python packaging and reproducible release archives
/build/
/dist/
/sdist/
/wheels/
*.whl
*.egg-info/
.eggs/
pip-wheel-metadata/
.installed.cfg

# Panda3D uses .egg as a source model format; it is not a Python package here.
!*.egg
!*.bam
!*.pz
!*.prc

# Test, coverage, lint, and type-checking caches
.pytest_cache/
.hypothesis/
.tox/
.nox/
.mypy_cache/
.pyright/
.pyre/
.pytype/
.ruff_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.py,cover

# Jupyter and IPython local state or derived notebook copies
.ipynb_checkpoints/
.jupyter_cache/
.virtual_documents/
.ipython/
.jupyter/
profile_default/
ipython_config.py
executed/
notebook-output/
*.nbconvert.ipynb
*.executed.ipynb
*-executed.ipynb
*_executed.ipynb

# Generated course outputs. Do not ignore media by extension: the supplied
# PNG/JPG/WAV/AVI/MOV files under the weekly data folders are source assets.
outputs/
frames/
background/
composite/
/COMP3419-W06-Lab-Files/play/
/COMP3419-W06-Lab-Files/volume/

# Deterministic staff-side figures are regenerated by the checked-in scripts
# and are deliberately excluded from student code archives.
/COMP3419-W*-Lab-Files/figures/
/docs/latex/**/figures/

# Panda3D runtime data
.panda3d/
model-cache/
pstats/
*.pstats
panda3d.log

# Environment overrides and local configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
!.envrc.example
.direnv/
*.local.json
*.local.toml
*.local.yaml
*.local.yml
local_settings.py

# Credentials, tokens, private keys, and local package-manager authentication
.secrets/
secrets.local/
credentials.json
credentials.*.json
!credentials.example.json
client_secret*.json
service-account*.json
service_account*.json
token.json
tokens.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
.netrc
.npmrc
.pypirc
pip.conf

# Student submissions and personally identifiable assessment records
/submissions/
/student-submissions/
/student_submissions/
/grading/
/gradebook/
/marking-records/
/moderation/
/turnitin/
/staff-private/
/staff-notes/
/private-notes/
/student-feedback-private/
/gradebook*.csv
/gradebook*.xlsx
/grades-export*.csv
/marks-export*.csv
SID*_Ass*.zip
SID*_Assignment*/

# Logs, crash dumps, local databases, and temporary files
*.log
*.dmp
*.stackdump
core
core.*
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.db-journal
*.pid
*.tmp
*.temp
*.bak
*.orig
*.rej

# LaTeX build intermediates; source .tex and intentional PDFs remain trackable
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# macOS metadata and extracted archive resource forks
.DS_Store
.AppleDouble
.LSOverride
._*
__MACOSX/
.Spotlight-V100/
.Trashes/
.fseventsd/

# Windows filesystem and Explorer metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux desktop/filesystem state
.directory
.Trash-*/
.nfs*

# Editors, IDEs, and local AI-agent state
.vscode/
.idea/
.vs/
.fleet/
.history/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~
/.agents/
/.codex/
/.claude/
/.cursor/
/.windsurf/

# Reproducibility files must be committed.
!/.python-version
!/pyproject.toml
!/uv.lock
